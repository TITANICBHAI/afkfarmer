modules = ["python-3.12", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GitHub workspace sync"

[[workflows.workflow]]
name = "GitHub workspace sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash github_push.sh --sync --yes"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["android-tools", "gitFull", "playwright-driver", "gcc"]
